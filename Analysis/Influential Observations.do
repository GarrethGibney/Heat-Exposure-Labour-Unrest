		i.num_above_90_60d ///
		i.year ///
        if year != 2020 ///
        & season == 3 ///
        & fips != `c', ///
        absorb(fips month) cluster(fips date) offset(log_emp)

    esttab using "C:\Users\20234503\Desktop\Research\Weather and Strikes\Project\Results_Jan2026\Raw\FIPS\Conflict\baseline_`c'.csv", ///
        cells("b se") noobs plain replace
}
