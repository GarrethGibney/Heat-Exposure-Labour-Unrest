gen doy = doy(date)
egen hot_day_7 = rowtotal(tavg_norm_above_3sd_lag_7d)
gen ln_hot_day = ln(hot_day + 0.01)
gen hot_day_incidence = 0
replace hot_day_incidence = 1 if hot_day > 0

gen nn_tavg_above_90_lag_90d_2 = nn_tavg_above_90_lag_90d*nn_tavg_above_90_lag_90d
gen test = 0

